# Copy this file to `.env.local` (or `.env`) and fill in real values.
# Vite only exposes variables prefixed with `VITE_` to client-side code.
# Restart the dev server after changing any env var.

# Waitlist (Landing page) — Formspree endpoint
# Defaults to https://formspree.io/f/mdayvaoz if unset.
# Override here to send signups to a different Formspree form.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mdayvaoz
